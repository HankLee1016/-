# PostgreSQL 連線設定
DB_HOST=localhost
DB_PORT=5432
DB_ADMIN_DB=postgres
DB_NAME=volunteer_db
DB_USER=postgres
DB_PASSWORD=postgres

# 若你要連接 Supabase 或其他遠端 PostgreSQL，請改成你的專案設定
# DB_HOST=你的Host
# DB_PORT=5432
# DB_ADMIN_DB=postgres
# DB_NAME=你的資料庫名稱
# DB_USER=你的使用者名稱
# DB_PASSWORD=你的密碼

# Flask
SECRET_KEY=change-me-in-production

# OpenAI（1-A 真實 AI 串接）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_MOCK_MODE=false
AI_MIN_SECTION_CHARS=40
AI_MIN_TOTAL_CHARS=380
