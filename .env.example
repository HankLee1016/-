# PostgreSQL 連線設定
DB_HOST=localhost
DB_PORT=5432
DB_ADMIN_DB=postgres
DB_NAME=volunteer_db
DB_USER=postgres
DB_PASSWORD=postgres

# 若你要連接 Supabase 或其他遠端 PostgreSQL，請改成你的專案設定
# DB_HOST=你的Host
# DB_PORT=5432
# DB_ADMIN_DB=postgres
# DB_NAME=你的資料庫名稱
# DB_USER=你的使用者名稱
# DB_PASSWORD=你的密碼

# 系統資料表所在之 schema（預設 elder）
# DB_SCHEMA=elder

# OpenAI（AI 福利小幫手與企劃助理；未設定時改用內建之比對與引導問答）
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- 改用其他 OpenAI 相容服務（例如 Google Gemini 免費額度）時設定----
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-latest
# AI_TIMEOUT_SECONDS=30
# AI_REASONING_EFFORT=low
